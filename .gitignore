# ─── Build output ─────────────────────────────────────────────────────────────
dist/
build/
*.build/
*.dist/
*.onefile-build/

# ─── EXE files (distributed via GitHub Releases, not committed to git) ────────
*.exe

# ─── Nuitka cache ─────────────────────────────────────────────────────────────
*.nuitka-cache/
*.nuitka/

# ─── PyInstaller leftovers ────────────────────────────────────────────────────
*.spec

# ─── Temp files created during build ─────────────────────────────────────────
extract_icon.py
version_info.txt
bluowl_temp_icon.ico

# ─── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ─── App runtime files ────────────────────────────────────────────────────────
*.log
logs/
startup_timer.py

# ─── App settings (user-specific, should not be shared) ──────────────────────
.BluOwlSerialMonitor_settings.json

# ─── OS clutter ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE / editor folders ─────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ─── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
